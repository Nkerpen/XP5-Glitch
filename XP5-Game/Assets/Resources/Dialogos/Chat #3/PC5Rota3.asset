%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 28925c74c269e124dab39a3c23e16a39, type: 3}
  m_Name: PC5Rota3
  m_EditorClassIdentifier: Assembly-CSharp::NoDeDialogo
  idDaConversa: 
  idDoNo: 
  mensagens:
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "eu n\xE3o sabia, eu suspeitava."
    tempoDeDigitacao: 1.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "tem uma diferen\xE7a."
    tempoDeDigitacao: 1
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "e quando mandei o relat\xF3rio, tentei sinalizar que era s\xE9rio
      e que ele deveria ter cuidado."
    tempoDeDigitacao: 3
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "mas a gente n\xE3o se fala por voz."
    tempoDeDigitacao: 1.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: nunca se falou, na verdade.
    tempoDeDigitacao: 1.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "s\xF3 texto."
    tempoDeDigitacao: 1.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "n\xE3o sei se voc\xEA \xE9 quem diz ser, se voc\xEA est\xE1
      tentando ajudar ou atrapalhar."
    tempoDeDigitacao: 3.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: mas o john confiava nas pessoas com cuidado.
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "e em algum momento decidiu confiar em algu\xE9m que n\xE3o
      devia."
    tempoDeDigitacao: 2.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "tem uma coisa que talvez voc\xEA deva verificar fora daqui."
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: abra o app de notas do celular quando puder.
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "talvez ele deixou algo l\xE1."
    tempoDeDigitacao: 1.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: vou entrar em contato no futuro, por um canal seguro.
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "isso, \xE9 claro, se voc\xEA quiser continuar essa conversa
      de um jeito que n\xE3o seja esse celular."
    tempoDeDigitacao: 3.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "aparentemente, porque esse celular n\xE3o \xE9 seguro."
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: mais uma coisa.
    tempoDeDigitacao: 1
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "tome cuidado com quem voc\xEA conta sobre essa conversa."
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "n\xE3o estou dizendo que algu\xE9m no c\xEDrculo do john est\xE1
      envolvido."
    tempoDeDigitacao: 2.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "estou dizendo que quando algu\xE9m some, geralmente, em algum
      lugar, h\xE1 uma porta aberta que algu\xE9m deixou. "
    tempoDeDigitacao: 4
  escolhas: []
