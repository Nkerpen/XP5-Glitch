  mensagens:
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: justo.
    tempoDeDigitacao: 1
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "ent\xE3o eu tamb\xE9m."
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "mas proponho um trato: eu fa\xE7o uma pergunta. voc\xEA responde
      se quiser. "
    tempoDeDigitacao: 4
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "voc\xEA faz uma pergunta. eu respondo se puder."
    tempoDeDigitacao: 2.5
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: vou perguntar uma coisa simples.
    tempoDeDigitacao: 2
  - autor: {fileID: 11400000, guid: dadee4420f427d941b531a67f5c26199, type: 2}
    textoDaMensagem: "o john est\xE1 bem?"
    tempoDeDigitacao: 2
  escolhas:
  - textoDaEscolha: "N\xE3o sabemos. Ele sumiu."
    proximoNo: {fileID: 11400000, guid: 17c637a513b96fd4eb1a0728a410c77a, type: 2}
    encerraPuzzle: 0
    jogadorGanhou: 0
    avancaAHistoria: 0
  - textoDaEscolha: Estamos procurando ele. Por isso encontrei seu contato.
    proximoNo: {fileID: 11400000, guid: c7a9225988d398c4bafa51a2f3b42cbf, type: 2}
    encerraPuzzle: 0
    jogadorGanhou: 0
    avancaAHistoria: 0
  - textoDaEscolha: "Vou ser honesto: n\xE3o sei se devia te contar isso."
